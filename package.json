{
  "name": "valley-shuttle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-road-profiles.mjs && node scripts/check-local-scene.mjs && tsx scripts/check-road-contact.ts && tsx scripts/check-building-surfaces.ts && tsx scripts/check-modeled-terrain.ts && tsx scripts/check-parking-layout.ts && tsc -b && vite build",
    "build:corridor": "node scripts/build-corridor.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:local-footprints": "python3 scripts/build-local-footprints.py",
    "fetch:local-aerial": "python3 scripts/fetch-local-aerial.py && python3 scripts/fetch-local-aerial.py --campus",
    "check:startup": "node scripts/check-startup.mjs",
    "build:landscape": "node scripts/build-landscape.mjs",
    "alerts": "node --env-file=.env.server server/index.mjs",
    "alerts:sample": "node server/index.mjs --sample",
    "test:alerts": "node --test server/*.test.mjs",
    "alerts:check": "node --env-file=.env.server server/index.mjs --once",
    "alerts:export": "node server/export-history.mjs",
    "pilot:approve": "node --env-file=.env.server --disable-warning=ExperimentalWarning server/pilot.mjs approve",
    "pilot:list": "node --env-file=.env.server --disable-warning=ExperimentalWarning server/pilot.mjs list",
    "pilot:remove": "node --env-file=.env.server --disable-warning=ExperimentalWarning server/pilot.mjs remove",
    "build:mobile-scene": "node scripts/build-mobile-scene.mjs",
    "check:mobile-scene": "node scripts/build-mobile-scene.mjs --check && node scripts/check-mobile-scene.mjs",
    "website:prepare": "node scripts/version-website-assets.mjs",
    "website:check": "node scripts/version-website-assets.mjs --check",
    "model:report": "node server/model-report.mjs"
  },
  "dependencies": {
    "@turf/buffer": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "lucide-react": "^0.468.0",
    "mailauth": "^8.0.4",
    "mailparser": "^3.14.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svix": "^2.9.1",
    "three": "^0.180.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "polyclip-ts": "^0.16.8",
    "sharp": "^0.35.5",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "joi": "^18.3.1"
  }
}
