# Vercel backend template. Commit this file; never commit filled-in .env files.
# Add these values in bustrackr-api > Settings > Environment Variables > Production.
# A local copy does not update Vercel. Redeploy after changing production variables.

# Required from the NEW Resend account. Keep secrets blank in this template.
# Key must read received email content and webhook configuration (not sending-only).
RESEND_API_KEY=
# Webhook signing secret, starts with whsec_. This is not the API key.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_ID=
# Exact address configured as the camera's recipient, e.g. camera@<id>.resend.app.
RESEND_INBOUND_ADDRESS=

# Already configured in the hosted project.
RESEND_WEBHOOK_URL=https://bustrackr-api.vercel.app/api/resend/inbound
CAMERA_SENDER=avigilonalerts@vcs.net
CAMERA_MARKER=BEI Bus has arrived.

# Optional filters and behavior. These show the defaults.
CAMERA_SUBJECT=
CAMERA_CHECKPOINT=BEI campus corner
CAMERA_COOLDOWN_SECONDS=30
# Browser frontend origin only, without path or trailing slash. Native apps do not need CORS.
ALERT_ALLOWED_ORIGIN=https://thatxliner.github.io

# BLOB_READ_WRITE_TOKEN is managed by the connected private Vercel Blob store.
# Do not replace it with an empty value or copy it into this template.
# ALERT_HOST, ALERT_PORT, ALERT_STATE_FILE, ALERT_SCHEDULE_FILE and
# RESEND_HEALTH_SECONDS apply only to the standalone worker, not this deployment.
