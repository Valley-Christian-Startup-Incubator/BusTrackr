# Production: /Users/aimac/apps/bustrackr/.env.server on valley-big-mac.
# Copy this template to .env.server for local use; restart the service after editing. Never put these secrets in VITE_* or EXPO_PUBLIC_* variables.
RESEND_API_KEY=
# Signing secret returned by creating the webhook, starts with whsec_. Not the API key.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_ID=b7ce83fc-6a0d-4200-addb-2cf9951cbfed
# Exact public HTTPS endpoint registered with Resend.
RESEND_WEBHOOK_URL=https://bustrackr.valleychristianai.com/api/resend/inbound
# Comma-separated receiving addresses. Both must belong to a receiving-enabled domain.
RESEND_INBOUND_ADDRESS=fehren@inbound.valleychristianai.com,fehren2@inbound.valleychristianai.com
# Checks webhook configuration only. Email ingestion is push-based, never polled.
RESEND_HEALTH_SECONDS=30
# Pilot waitlist: signups become contacts in this Resend segment, and new ones get one confirmation email.
# Leave either blank to close the waitlist; the form then says it's closed.
WAITLIST_SEGMENT_ID=e1d4d97f-6e72-4381-be37-5d78cb2a69d8
WAITLIST_FROM=BusTrackr <pilot@valleychristianai.com>
CAMERA_SENDER=Avigilonalerts@vcs.net
# Optional until actual subject is confirmed. Sender + timestamped body are always required.
CAMERA_SUBJECT=
CAMERA_MARKER=BEI Bus has arrived.
CAMERA_CHECKPOINT=BEI campus corner
CAMERA_COOLDOWN_SECONDS=30
ALERT_HOST=127.0.0.1
ALERT_PORT=18787
# Camera history lives beside this path as SQLite (.data/alerts.sqlite). The JSON file is only read once, to import pre-SQLite history.
ALERT_STATE_FILE=.data/alerts.json
# Commit the worker was deployed from. New sightings record it with a hash of the worker's source files.
BUSTRACKR_COMMIT=
# Optional: mirror sightings into an Umami website. Production uses the loopback collector and the "BusTrackr camera sightings" website.
SIGHTINGS_UMAMI_URL=
SIGHTINGS_UMAMI_WEBSITE=
ALERT_SCHEDULE_FILE=server/schedule.json
# Rider reports on predictions, one JSON object per line. BUSTRACKR_COMMIT, when set, stamps each report with the worker's commit.
FEEDBACK_FILE=.data/feedback.jsonl
BUSTRACKR_COMMIT=
ALERT_ALLOWED_ORIGIN=https://bustrackr.valleychristianai.com,https://bustracker.valleychristianai.com,https://valley-christian-startup-incubator.github.io

# Opt-in background notifications. Keep push credentials private.
# Generate a matching VAPID pair with the web-push package. A subject is a mailto: or HTTPS contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@valleychristianai.com
NOTIFICATIONS_EXPO_ENABLED=false
# Set only if Expo enhanced push security is enabled on the EAS project.
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_STATE_FILE=.data/notifications.json
NOTIFICATIONS_APP_URL=https://bustrackr.valleychristianai.com/
# ALERT_ALLOWED_ORIGIN accepts comma-separated browser origins. Native clients omit Origin.
